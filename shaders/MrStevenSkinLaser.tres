code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_disabled, diffuse_lambert, specular_schlick_ggx;

uniform vec2 Speed = vec2(2.000000, 1.000000);
uniform sampler2D EnergyTexture;
uniform float Texture_Power = 1.5;
uniform sampler2D tex_frg_15;
uniform float GradientPower = 1.0;



void fragment() {
// Input:2
	vec4 n_out2p0 = COLOR;


// VectorDecompose:9
	float n_out9p0 = n_out2p0.x;
	float n_out9p1 = n_out2p0.y;
	float n_out9p2 = n_out2p0.z;
	float n_out9p3 = n_out2p0.w;


// Input:6
	float n_out6p0 = TIME;


// Vector2Parameter:12
	vec2 n_out12p0 = Speed;


// VectorOp:7
	vec2 n_out7p0 = vec2(n_out6p0) * n_out12p0;


// UVFunc:8
	vec2 n_in8p1 = vec2(1.00000, 1.00000);
	vec2 n_out8p0 = n_out7p0 * n_in8p1 + UV;


	vec4 n_out14p0;
// Texture2D:14
	n_out14p0 = texture(EnergyTexture, n_out8p0);


// VectorDecompose:4
	float n_out4p0 = vec3(n_out14p0.xyz).x;
	float n_out4p1 = vec3(n_out14p0.xyz).y;
	float n_out4p2 = vec3(n_out14p0.xyz).z;


// FloatParameter:11
	float n_out11p0 = Texture_Power;


// FloatOp:5
	float n_out5p0 = pow(n_out4p0, n_out11p0);


// FloatOp:10
	float n_out10p0 = n_out9p3 * n_out5p0;


// Texture2D:15
	vec4 n_out15p0 = texture(tex_frg_15, UV);


// VectorDecompose:16
	float n_out16p0 = n_out15p0.x;
	float n_out16p1 = n_out15p0.y;
	float n_out16p2 = n_out15p0.z;
	float n_out16p3 = n_out15p0.w;


// FloatParameter:18
	float n_out18p0 = GradientPower;


// FloatOp:17
	float n_out17p0 = pow(n_out16p0, n_out18p0);


// FloatOp:19
	float n_out19p0 = n_out10p0 * n_out17p0;


// Output:0
	ALBEDO = vec3(n_out2p0.xyz);
	ALPHA = n_out19p0;


}
