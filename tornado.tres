[resource]
code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_disabled, diffuse_lambert, specular_schlick_ggx, unshaded;

uniform vec2 Vector2Parameter;
uniform sampler2D textura_base : source_color, repeat_enable;
uniform sampler2D textura_2 : source_color, repeat_disable;
uniform sampler2D color : source_color, repeat_enable;
uniform float Opacity : hint_range(0.0, 1.0) = 1.0;



void fragment() {
// Vector2Parameter:5
	vec2 n_out5p0 = Vector2Parameter;


// Input:7
	float n_out7p0 = TIME;


// VectorOp:6
	vec2 n_out6p0 = n_out5p0 * vec2(n_out7p0);


// UVFunc:4
	vec2 n_in4p1 = vec2(1.00000, 1.00000);
	vec2 n_out4p0 = n_out6p0 * n_in4p1 + UV;


	vec4 n_out3p0;
// Texture2D:3
	n_out3p0 = texture(textura_base, n_out4p0);
	float n_out3p1 = n_out3p0.r;


	vec4 n_out9p0;
// Texture2D:9
	n_out9p0 = texture(textura_2, UV);


// VectorOp:10
	vec2 n_out10p0 = vec2(n_out3p1) - vec2(n_out9p0.xy);


// Clamp:11
	vec2 n_in11p1 = vec2(0.00000, 0.00000);
	vec2 n_in11p2 = vec2(1.00000, 1.00000);
	vec2 n_out11p0 = clamp(n_out10p0, n_in11p1, n_in11p2);


	vec4 n_out13p0;
// Texture2D:13
	n_out13p0 = texture(color, n_out11p0);
	float n_out13p4 = n_out13p0.a;


// FloatParameter:14
	float n_out14p0 = Opacity;


// FloatOp:15
	float n_out15p0 = n_out13p4 * n_out14p0;


// Output:0
	ALBEDO = vec3(n_out13p0.xyz);
	ALPHA = n_out15p0;


}
